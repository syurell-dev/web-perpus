    "menu": "node scripts/menu.js"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
