{
  "name": "web-perpus",
  "version": "1.3.4",
  "description": "Aplikasi web perpustakaan sekolah",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --ignore public/vendor/ --ignore database/ server.js",
